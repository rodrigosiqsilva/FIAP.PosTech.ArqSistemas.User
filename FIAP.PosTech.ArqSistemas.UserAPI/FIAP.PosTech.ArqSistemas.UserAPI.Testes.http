// Guia de Testes CRUD para API de Usuário
// Todas as requisições incluem o header X-Correlation-Id (gerado automaticamente se não fornecido)

@HostAddress = https://localhost:7047


### 1. Requisição de Login (Gera o Token)
# @name login
POST {{HostAddress}}/login
Content-Type: application/json
{
    "email": "joao@example.com",
    "senha": "SenhaSegura@123"
}

### 2. OBTER TODOS OS USUÁRIOS
GET {{HostAddress}}/api/usuario
Authorization: Bearer {{login.response.body.$.token}}
X-Correlation-Id: test-002

###
// 3. OBTER USUÁRIO POR ID 
GET {{HostAddress}}/api/usuario/1
Authorization: Bearer {{login.response.body.$.token}}
X-Correlation-Id: test-003

###
// 4. CRIAR NOVO USUÁRIO
// Requisitos: Nome, Email, Senha (todos obrigatórios)
// Formato de Email: email válido
// Senha: mínimo de 8 caracteres, pelo menos 1 letra, 1 dígito, 1 caractere especial [!@#$%^&*\-_=+]
POST {{HostAddress}}/api/usuario
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json
X-Correlation-Id: test-004
{
  "nome": "Rodrigo Siqueira Silva",
  "email": "rodrigosiqueirasilva@hotmail.com",
  "senha": "TesteSenha@123"
}

###
// 5. ATUALIZAR USUÁRIO
// Requisitos: Id na URL (obrigatório), todos os campos no corpo (nome, email, senha)
// As mesmas regras de validação se aplicam
PUT {{HostAddress}}/api/usuario/1
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json
X-Correlation-Id: test-005

{
  "nome": "João Silva Atualizado",
  "email": "joao.atualizado@example.com",
  "senha": "NovaSenha@456"
}

###
// 6. EXCLUIR USUÁRIO
// Requisitos: Apenas Id necessário (na URL)
DELETE {{HostAddress}}/api/usuario/6
Authorization: Bearer {{login.response.body.$.token}}
X-Correlation-Id: test-006

###
// Casos de teste para erros de validação:

// ERRO: Formato de email inválido
POST https://localhost:7047/api/usuario
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "nome": "Test User",
  "email": "invalid-email",
  "senha": "ValidSenha@123"
}

###
// ERRO: Senha fraca (menos de 8 caracteres)
POST {{HostAddress}}/api/usuario
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "nome": "Test User",
  "email": "valid@example.com",
  "senha": "Weak@1"
}

###
// ERRO: Senha sem caractere especial
POST {{HostAddress}}/api/usuario
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "nome": "Test User",
  "email": "valid@example.com",
  "senha": "NoSpecialChar123"
}

###
// ERRO: Campo obrigatório ausente (Email)
POST {{HostAddress}}/api/usuario
Authorization: Bearer {{login.response.body.$.token}}
Content-Type: application/json

{
  "nome": "Test User",
  "senha": "ValidSenha@123"
}