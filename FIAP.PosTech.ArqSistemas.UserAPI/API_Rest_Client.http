<!-- Usuario API - HTTP REST Client Examples -->

### ========== SECTION 1: Retrieve Operations ==========

### GET ALL USUARIOS
GET https://localhost:7011/api/usuario
X-Correlation-Id: {{$guid}}
Accept: application/json

### GET USUARIO BY ID (Existing - ID from seed data)
GET https://localhost:7011/api/usuario/1
X-Correlation-Id: {{$guid}}
Accept: application/json

### GET USUARIO BY ID (Non-existent)
GET https://localhost:7011/api/usuario/999
X-Correlation-Id: {{$guid}}
Accept: application/json

### ========== SECTION 2: Create Operations (Success Cases) ==========

### CREATE NEW USUARIO - Basic Valid User
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Novo Usuario Teste",
  "email": "novousuario@example.com",
  "senha": "SenhaSegura@123"
}

### CREATE NEW USUARIO - Another Valid User
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Segundo Usuario Teste",
  "email": "segundo@example.com",
  "senha": "OutraSenha#789"
}

### CREATE NEW USUARIO - With Special Characters in Password
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Com Senha Complexa",
  "email": "complexa@example.com",
  "senha": "Sen@h@Muito$Complex!123"
}

### ========== SECTION 3: Create Operations (Validation Error Cases) ==========

### CREATE FAIL - Missing Nome
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "email": "teste@example.com",
  "senha": "SenhaSegura@123"
}

### CREATE FAIL - Missing Email
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Sem Email",
  "senha": "SenhaSegura@123"
}

### CREATE FAIL - Missing Senha
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Sem Senha",
  "email": "semsenha@example.com"
}

### CREATE FAIL - Invalid Email Format
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Email Invalido",
  "email": "email-invalido-sem-arroba",
  "senha": "SenhaSegura@123"
}

### CREATE FAIL - Password Less Than 8 Characters
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Senha Curta",
  "email": "senhacurta@example.com",
  "senha": "Pwd@1"
}

### CREATE FAIL - Password Without Letter
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Sem Letra",
  "email": "semltra@example.com",
  "senha": "12345678@"
}

### CREATE FAIL - Password Without Number
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Sem Numero",
  "email": "semnum@example.com",
  "senha": "SenhaSegura@NoDigit"
}

### CREATE FAIL - Password Without Special Character
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Sem Especial",
  "email": "semespecial@example.com",
  "senha": "SenhaSegura123"
}

### CREATE FAIL - Duplicate Email
POST https://localhost:7011/api/usuario
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Duplicado",
  "email": "joao@example.com",
  "senha": "SenhaSegura@123"
}

### ========== SECTION 4: Update Operations (Success Cases) ==========

### UPDATE USUARIO - Valid Update (all fields)
PUT https://localhost:7011/api/usuario/1
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "João Silva Atualizado",
  "email": "joao.novo@example.com",
  "senha": "NovaSenha@456"
}

### UPDATE USUARIO - Partial Update (only nome)
PUT https://localhost:7011/api/usuario/2
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Maria Santos - Updated Name Only"
}

### UPDATE USUARIO - Partial Update (only email)
PUT https://localhost:7011/api/usuario/3
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "email": "pedro.novo@example.com"
}

### UPDATE USUARIO - Partial Update (only senha)
PUT https://localhost:7011/api/usuario/4
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "senha": "NovaSenh@789"
}

### UPDATE USUARIO - Partial Update (nome and email)
PUT https://localhost:7011/api/usuario/5
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Carlos Mendes - Updated",
  "email": "carlos.novo@example.com"
}

### ========== SECTION 5: Update Operations (Validation Error Cases) ==========

### UPDATE FAIL - User Not Found
PUT https://localhost:7011/api/usuario/999
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "Usuario Inexistente",
  "email": "inexistente@example.com",
  "senha": "SenhaSegura@123"
}

### UPDATE FAIL - Invalid Email Format
PUT https://localhost:7011/api/usuario/1
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "João Silva",
  "email": "email-invalido",
  "senha": "SenhaSegura@123"
}

### UPDATE FAIL - Weak Password
PUT https://localhost:7011/api/usuario/1
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "João Silva",
  "email": "joao@example.com",
  "senha": "Fraca@1"
}

### UPDATE FAIL - Duplicate Email (Another User)
PUT https://localhost:7011/api/usuario/1
Content-Type: application/json
X-Correlation-Id: {{$guid}}

{
  "nome": "João Silva",
  "email": "maria@example.com",
  "senha": "SenhaSegura@123"
}

### ========== SECTION 6: Delete Operations ==========

### DELETE USUARIO - Valid Delete (Id 6 from create above)
DELETE https://localhost:7011/api/usuario/6
X-Correlation-Id: {{$guid}}

### DELETE USUARIO - Try Non-existent User
DELETE https://localhost:7011/api/usuario/999
X-Correlation-Id: {{$guid}}

### DELETE USUARIO - Another Valid Delete
DELETE https://localhost:7011/api/usuario/7
X-Correlation-Id: {{$guid}}

### ========== SECTION 7: Verify Final State ==========

### GET ALL USUARIOS - Final State
GET https://localhost:7011/api/usuario
X-Correlation-Id: {{$guid}}
Accept: application/json

### ========== NOTES ==========
# - X-Correlation-Id header can be provided or will be auto-generated
# - All responses include CorrelationId for request tracing
# - Responses use ISO 8601 timestamps (UTC)
# - Password requirements:
#   * Minimum 8 characters
#   * At least 1 letter (a-zA-Z)
#   * At least 1 digit (0-9)
#   * At least 1 special character (!@#$%^&*-_=+)
# - Seed data (pre-loaded):
#   ID 1: João Silva / joao@example.com
#   ID 2: Maria Santos / maria@example.com
#   ID 3: Pedro Oliveira / pedro@example.com
#   ID 4: Ana Costa / ana@example.com
#   ID 5: Carlos Mendes / carlos@example.com
